# Copie para .env (chmod 600) e preencha. NUNCA versionar o .env.
OPENAI_API_BASE_URLS=http://SEU_SERVIDOR:8081/v1;http://SEU_SERVIDOR:8083/v1
OPENAI_API_KEYS=SUA_CHAVE;SUA_CHAVE
WEBUI_SECRET_KEY=GERAR_COM_openssl_rand_hex_32
ENABLE_OLLAMA_API=false
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
WEBUI_NAME=IA
DEFAULT_LOCALE=pt-BR
# pesquisa na web (SearXNG ja existente)
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://host.docker.internal:8888/search?q=<query>&format=json
WEB_SEARCH_RESULT_COUNT=5
# pouca RAM/CPU: sem embeddings locais, texto do arquivo vai direto no contexto
BYPASS_EMBEDDING_AND_RETRIEVAL=true
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=true
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
